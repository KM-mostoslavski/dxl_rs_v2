    {
      data_name: "PWM Limit",
      value: 0.1,
      unit: "%",
      sign_type: "unsigned",
      range: (min: 0, max: 1000),
    },
    // DECISION: the page gives current in 0.01 [A] steps; one step is written as 10.0 mA, since A is not in the unit list.
    {
      data_name: "Current Limit",
      value: 10.0,
      unit: "mA",
      sign_type: "unsigned",
      range: (min: 0, max: 2240),
