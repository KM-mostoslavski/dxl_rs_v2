    },
    {
      data_name: "Goal Current",
      value: 10.0,
      unit: "mA",
      sign_type: "twos_complement",
      bounded_by: "Current Limit",
    },
    {
      data_name: "Goal Velocity",
      value: 0.01,
      unit: "rpm",
      sign_type: "twos_complement",
      bounded_by: "Velocity Limit",
    },
    // DECISION: Profile Velocity is used only by the velocity-based profile (Drive Mode bit 2), its range is 0 ~ Velocity Limit(72), and 0 deactivates the profile (no profile velocity bound), read as unlimited.
    {
      data_name: "Profile Velocity",
      value: 0.01,
      unit: "rpm",
      sign_type: "unsigned",
