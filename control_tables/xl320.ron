      range: (min: 0, max: 1023),
    },
    {
      data_name: "Goal Position",
      value: 0.29,
      unit: "deg",
      sign_type: "unsigned",
      range: (min: 0, max: 1023),
    },
    // DECISION: Moving Speed and Present Speed get no entry: the page gives 0.111 rpm in Joint Mode and 0.1 % in Wheel Mode (bit 10 the direction bit in Wheel Mode, and in both modes for Present Speed), and modes is only allowed in an angle-limit table (the XL-320 switches by Control Mode), so one entry would mis-scale one of the two modes (D-17).
    {
      data_name: "Torque Limit",
      value: 0.1,
      unit: "%",
      sign_type: "unsigned",
      range: (min: 0, max: 1023),
    },
