      range: (min: 0, max: 1023),
    },
    // DECISION: the page gives Temperature Limit 0 ~ 150 in its control table and 0 ~ 100 in the register description; the range is the part both allow, 0 ~ 100.
    {
      data_name: "Temperature Limit",
      value: 1.0,
      unit: "°C",
      sign_type: "unsigned",
      range: (min: 0, max: 100),
    },
    // DECISION: the page gives Min/Max Voltage Limit 50 ~ 250 in its control table and description table, and 50 to 160 in the description text; the range is the part all three allow, 50 ~ 160.
    {
      data_name: "Min Voltage Limit",
      value: 0.1,
      unit: "V",
      sign_type: "unsigned",
      range: (min: 50, max: 160),
    },
