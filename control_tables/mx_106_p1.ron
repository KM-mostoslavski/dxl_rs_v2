  protocols: [P1],
  torque_control_mode: (register: "Torque Ctrl Mode Enable", on: 1, goal: "Goal Torque"),
  type_info: {
    value_of_zero_radian_position: 2048,
    value_of_max_radian_position: 4095,
    value_of_min_radian_position: 0,
    min_radian: -3.1415927,
    max_radian: 3.1400587,
  },
  unit_info: [
    // DECISION: CW/CCW Angle Limit carry no `modes`: the registers hold 0..4095 in every mode (4095/4095 selects multi-turn).
    // DECISION: Goal/Present Position have no multi_turn entry: the page makes the multi-turn step 0.088 times Resolution Divider.
    // DECISION: Current has no entry: the page reads it as 4.5 mA times (raw - 2048), an offset one step cannot express.
    {
      data_name: "Return Delay Time",
      value: 2.0,
      unit: "µs",
      sign_type: "unsigned",
      range: (min: 0, max: 254),
    },
    {
